# Backend-only settings. Neon URLs are also loaded from root .env.local / .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Render + Vercel default domains: set none with NODE_ENV=production and HTTPS.
# Same-site custom domains can use lax. Some browsers block third-party cookies.
SESSION_COOKIE_SAME_SITE=lax

# Google Identity Services: Web application OAuth client ID (no client secret needed).
GOOGLE_CLIENT_ID=

# Email provider: auto prefers Resend, then SMTP, then a local dev outbox.
# Use Resend's HTTPS API on Render (SMTP ports are blocked on free services).
MAIL_PROVIDER=auto
RESEND_API_KEY=
MAIL_FROM=BluffX <no-reply@your-verified-domain.example>

# Optional SMTP alternative for hosts that allow it. Not needed for Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PostgreSQL is required locally and in production. Use the provider connection URL.
# Keep credentials on the backend; never use a VITE_ variable.
DATABASE_URL=
# Neon supplies the direct URL for schema setup/imports as well:
DATABASE_URL_UNPOOLED=

# Optional absolute path for local email previews.
# MAIL_OUTBOX_PATH=
# Set NODE_ENV=production only with HTTPS; session cookies then require HTTPS.
