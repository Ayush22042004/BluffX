# Backend-only settings. Neon URLs are also loaded from root .env.local / .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Render + Vercel default domains: set none with NODE_ENV=production and HTTPS.
# Same-site custom domains can use lax. Some browsers block third-party cookies.
SESSION_COOKIE_SAME_SITE=lax

# Google Identity Services: Web application OAuth client ID (no client secret needed).
GOOGLE_CLIENT_ID=

# Email provider: auto prefers Gmail API, then Brevo, Resend, SMTP, local dev previews.
# Use an HTTPS email API on Render. Brevo setup: docs/brevo.md.
MAIL_PROVIDER=auto
# Existing Gmail mailbox over HTTPS, no SMTP/custom sending domain. See docs/gmail.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_USER=
GMAIL_REFRESH_TOKEN=
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=BluffX <no-reply@your-verified-domain.example>
# Optional owner inbox for player-report notifications. Keep private/backend only.
# No verified domain yet: use MAIL_FROM=BluffX <onboarding@resend.dev> and
# REPORTS_TO must be the address used for your Resend account (testing only).
REPORTS_TO=
REPORT_EMAIL_MAX_DAILY=20
REPORT_EMAIL_INTERVAL_MS=60000

# Optional SMTP alternative for hosts that allow it. Not needed for Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PostgreSQL is required locally and in production. Use the provider connection URL.
# Keep credentials on the backend; never use a VITE_ variable.
DATABASE_URL=
# Neon supplies the direct URL for schema setup/imports as well:
DATABASE_URL_UNPOOLED=

# Apply reviewed migrations manually with npm run db:migrate-games before startup.
# Enable automatic migrations only on an explicitly isolated development database.
GAME_AUTO_MIGRATE=false
GAME_GRACE_MS=10000
GAME_AI_ROUNDS=3
GAME_AI_RENEWAL_MS=60000
GAME_AFK_STRIKES=3
GAME_RESULT_MS=10000
GAME_PROVISIONAL_MS=10000
GAME_MAX_CARDS=4
GAME_RESUME_MS=86400000
GAME_RETENTION_DAYS=30
# Bound pathological matches; expiry is abandoned and never awards ranked wins.
GAME_MAX_MATCH_MS=21600000
GAME_MAX_ROOMS=500
GAME_STORAGE_TIMEOUT_MS=10000
GAME_STORAGE_CONNECT_ATTEMPTS=3
# Small combined process budget: four game connections, two auth, one owner.
GAME_POOL_SIZE=4
AUTH_POOL_SIZE=2
# Completed tables close after five minutes; official results remain in Neon.
GAME_FINISHED_MEMORY_MS=300000
# Diagnostics are opt-in. Local /debug/metrics is never exposed in production.
GAME_DIAGNOSTICS=false
# Token-bucket limits: per connection, identity, and sensitive setup event.
GAME_CONNECTION_BURST=30
GAME_EVENT_BURST=40
GAME_EVENT_REFILL=8
GAME_SETUP_BURST=6
GAME_SETUP_PER_MINUTE=12

# Closed playtest controls; never send the allowlist or operator token to Vercel.
PLAYTEST_UNRANKED=false
PLAYTEST_INVITE_ONLY=false
GAME_ADMISSIONS_OPEN=true
# PLAYTEST_ALLOWED_EMAILS=first@example.com,second@example.com
RANKED_REQUIRE_VERIFIED=true
RANKED_PAIR_DAILY_LIMIT=3
# Generate a random 32+ character operator token for private metrics/report access.
# OPS_API_TOKEN=
# RATE_IDENTITY_SECRET=
# VOICE_TURN_PROVIDER=cloudflare
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Force relay temporarily to prove the TURN path works; normally false.
VOICE_RELAY_ONLY=false

# Optional WebRTC voice connectivity. Audio never passes through Render or Neon.
VOICE_STUN_URL=stun:stun.l.google.com:19302
# For restrictive networks, use a TURN REST-compatible relay (e.g. coturn).
# Comma-separated turn:/turns: URLs. Keep the shared auth secret on the backend.
# VOICE_TURN_URL=turn:your-relay.example.com:3478,turns:your-relay.example.com:5349
# VOICE_TURN_SECRET=

# Optional absolute path for local email previews.
# MAIL_OUTBOX_PATH=
# Set NODE_ENV=production only with HTTPS; session cookies then require HTTPS.
