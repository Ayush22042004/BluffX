{
  "name": "bluffx-server",
  "version": "0.2.0",
  "description": "Realtime server for BluffX multiplayer card game",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "start:test": "node --require ./test/postgres-fixture.cjs src/index.js",
    "check:neon": "node scripts/check-neon.js",
    "check:deployment": "node scripts/check-deployment.js",
    "db:migrate-sqlite": "node scripts/migrate-sqlite.js",
    "db:migrate-games": "node scripts/migrate-games.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
