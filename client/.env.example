# Public API origin: localhost for development, https://bluffx.vercel.app for the production proxy.
# No database or email secrets belong in client variables.
VITE_SERVER_URL=http://localhost:4000
# Production defaults to its own origin when VITE_SERVER_URL is absent.
# Enable standard WebSocket upgrades with polling fallback; set false only
# when a tested reverse proxy does not support the upgrade route.
VITE_SOCKET_UPGRADE=true
