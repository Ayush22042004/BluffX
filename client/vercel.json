{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://bluffx.onrender.com/auth/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://bluffx.onrender.com/socket.io/"
    },
    {
      "source": "/socket.io/",
      "destination": "https://bluffx.onrender.com/socket.io/"
    },
    {
      "source": "/health",
      "destination": "https://bluffx.onrender.com/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
